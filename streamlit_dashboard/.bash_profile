Export PATH=${PATH}:/usr/local/mysql/bin
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/Users/reubenharuray/miniconda3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/Users/reubenharuray/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/Users/reubenharuray/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/Users/reubenharuray/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
source /Users/reubenharuray/miniconda3/etc/profile.d/conda.sh
# <<< conda initialize <<<

